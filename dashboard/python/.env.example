# コピーして .env を作り、実際の値を入れる（.env はコミットしない）
MED_GA4_PROPERTY_ID=123456789
# JSON 鍵は public_html の外に置く
GOOGLE_APPLICATION_CREDENTIALS=/home/サーバーID/secure/ga4-service-account.json
MED_WP_BASE_URL=https://YOUR-DOMAIN.example
MED_WP_USER=admin
# WordPress 管理画面 > ユーザー > プロフィール > アプリケーションパスワード で発行
MED_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
